  "unit": 5,
  "unit_title": "Factoring and Quadratic Functions",
  "section_summaries": {
    "5.1": {
      "section": "5.1",
      "title": "GCF and Structure",
      "learning_target": "Students will identify common factors and use structure to rewrite polynomial expressions.",
      "i_cans": [
        "I can construct equivalent polynomial expressions by factoring out a greatest common factor.",
        "I can apply structure to rewrite polynomial expressions in a more useful form.",
        "I can determine whether a rewritten expression is reasonable by checking common factors and equivalent products."
      ],
      "vocabulary": [
        "greatest common factor",
        "factor",
        "term",
        "coefficient",
        "equivalent expression"
      ],
      "key_representations": [
        "Polynomial expressions in expanded form",
        "Factored expressions with greatest common factors",
        "Area models for common-factor structure",
        "Tables of term coefficients and variable powers",
        "Verbal contexts involving shared quantities"
      ],
      "misconceptions": [
        "Factoring out a quantity that is not common to every term.",
        "Failing to verify the factored form by multiplication."
      ],
      "intro": "Identify common factors and use structure to rewrite polynomial expressions.",
      "review": "Add, subtract, and multiply polynomial expressions.",
      "mastery": "Solve systems using substitution and choose efficient forms for solving.",
      "framework_section_packet": "reference_library/question_structures/section_enrichment.json"
    },
    "5.2": {
      "section": "5.2",
      "title": "Factoring Trinomials",
      "learning_target": "Students will factor quadratic trinomials using patterns, products, sums, and structure.",
      "i_cans": [
        "I can build factored forms of quadratic trinomials using product-sum relationships.",
        "I can use patterns in coefficients and constants to factor quadratic trinomials.",
        "I can predict missing factors or terms by extending product-sum reasoning."
      ],
      "vocabulary": [
        "trinomial",
        "binomial factor",
        "product-sum relationship",
        "factor pair",
        "quadratic"
      ],
      "key_representations": [
        "Standard-form quadratic trinomials",
        "Factored binomial products",
        "Product-sum tables",
        "Algebra tiles or area models",
        "Partial-factor work showing structure"
      ],
      "misconceptions": [
        "Using factor pairs that multiply correctly but do not produce the required middle term.",
        "Stopping after finding one factor without verifying the full product."
      ],
      "intro": "Factor quadratic trinomials using patterns, products, sums, and structure.",
      "review": "Connect polynomial expressions to quadratic graphs and key features.",
      "mastery": "Solve systems graphically and by elimination while interpreting the meaning of different solution types.",
      "framework_section_packet": "reference_library/question_structures/section_enrichment.json"
    },
    "5.3": {
      "section": "5.3",
      "title": "Special Factoring Patterns",
      "learning_target": "Students will recognize and factor special polynomial patterns.",
      "i_cans": [
        "I can design a strategy for factoring special polynomial patterns.",
        "I can apply difference-of-squares and perfect-square-trinomial patterns.",
        "I can assess whether a polynomial fits a special factoring pattern before rewriting it."
      ],
      "vocabulary": [
        "difference of squares",
        "perfect-square trinomial",
        "factor",
        "square term",
        "pattern"
      ],
      "key_representations": [
        "Difference-of-squares expressions",
        "Perfect-square trinomials",
        "Squared binomial forms",
        "Pattern templates using variables and coefficients",
        "Visual square and rectangle models"
      ],
      "misconceptions": [
        "Applying a special pattern when the polynomial does not meet its structural conditions.",
        "Forgetting that a difference of squares requires subtraction between two square terms."
      ],
      "intro": "Recognize and factor special polynomial patterns.",
      "review": "Identify common function families from graphs, equations, tables, and contexts.",
      "mastery": "Create and solve systems that model real-world situations.",
      "framework_section_packet": "reference_library/question_structures/section_enrichment.json"
    },
    "5.4": {
      "section": "5.4",
      "title": "Factored Form and Zeros",
      "learning_target": "Students will connect factors, zeros, intercepts, and graphs of quadratic functions.",
      "i_cans": [
        "I can formulate quadratic functions in factored form from zeros or intercepts.",
        "I can use factored form to predict zeros and x-intercepts of quadratic graphs.",
        "I can extend connections among factors, zeros, intercepts, and graph behavior."
      ],
      "vocabulary": [
        "factored form",
        "zero",
        "x-intercept",
        "zero product property",
        "factor"
      ],
      "key_representations": [
        "Factored quadratic functions",
        "Zeros and x-intercepts",
        "Quadratic graphs",
        "Input-output tables near intercepts",
        "Context statements involving break-even or height reaching zero"
      ],
      "misconceptions": [
        "Treating factors themselves as zeros instead of setting each factor equal to zero.",
        "Confusing x-intercepts with y-intercepts."
      ],
      "intro": "Connect factors, zeros, intercepts, and graphs of quadratic functions.",
      "review": "Graph and write translated functions using key points and key features.",
      "mastery": "Graph and interpret linear inequalities.",
      "framework_section_packet": "reference_library/question_structures/section_enrichment.json"
    },
    "5.5": {
      "section": "5.5",
      "title": "Comparing Quadratic Forms",
      "learning_target": "Students will compare standard, vertex, and factored forms of quadratic functions and determine which form best reveals key features.",
      "i_cans": [
        "I can construct equivalent quadratic forms to reveal different key features.",
        "I can interpret standard, vertex, and factored forms to read key features of quadratic functions.",
        "I can critique which quadratic form best supports a given question or context."
      ],
      "vocabulary": [
        "standard form",
        "vertex form",
        "factored form",
        "vertex",
        "zeros"
      ],
      "key_representations": [
        "Standard form",
        "Vertex form",
        "Factored form",
        "Quadratic graphs with key features labeled",
        "Contexts involving maximums, minimums, intercepts, and starting values"
      ],
      "misconceptions": [
        "Assuming one quadratic form is always best for every question.",
        "Reading zeros, vertex, or intercepts from the wrong structural feature."
      ],
      "intro": "Compare standard, vertex, and factored forms of quadratic functions and determine which form best reveals key features.",
      "review": "Analyze and graph transformations involving stretches, compressions, and reflections.",
      "mastery": "Analyze and interpret systems of linear inequalities.",
      "framework_section_packet": "reference_library/question_structures/section_enrichment.json"
    }
  },
