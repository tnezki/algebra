  "section_summaries": {
    "2.1": {
      "section": "2.1",
      "title": "Rate of Change and Slope",
      "learning_target": "Students will interpret slope as a measure of constant rate of change.",
      "i_can_statements": [
        "I can construct rate-of-change statements from tables, graphs, and situations.",
        "I can apply slope calculations to interpret constant change between quantities.",
        "I can determine whether a slope value is reasonable for a given context."
      ],
      "vocabulary": [
        "slope",
        "rate of change",
        "rise/run",
        "positive/negative/zero/undefined slope"
      ],
      "key_representations": [
        "Slope triangles on coordinate graphs",
        "Tables showing equal input intervals",
        "Contextual rate statements",
        "Ratio notation for vertical change over horizontal change",
        "Positive, negative, zero, and undefined slope examples"
      ],
      "misconceptions": [
        "Reversing vertical and horizontal change or using inconsistent point order.",
        "Interpreting slope as a starting value rather than a rate."
      ],
      "intro": "Interpret slope as a measure of constant rate of change.",
      "review": "Interpret functions as rules that connect inputs and outputs without relying on formal domain and range language.",
      "mastery": "Recognize constant rate of change in tables, graphs, visual patterns, and situations.",
      "framework_section_packet_paths": [
        "reference_library/question_structures/section_enrichment.json#2.1",
        "reference_library/source_excerpts/section_source_excerpts.json#2.1",
        "sources/indexes/compact_stage_reference_map.json#2.1"
      ]
    },
    "2.2": {
      "section": "2.2",
      "title": "Graphing Linear Functions",
      "learning_target": "Students will graph linear functions and interpret key features.",
      "i_can_statements": [
        "I can build graphs of linear functions using slope and intercept information.",
        "I can use key features of a line to interpret a relationship.",
        "I can extend a graph to predict outputs within a meaningful range."
      ],
      "vocabulary": [
        "slope",
        "intercept",
        "$y=mx+b$",
        "linear graph",
        "scale"
      ],
      "key_representations": [
        "Coordinate plane graphs",
        "Slope-intercept form",
        "Intercepts and starting values",
        "Tables generated from linear rules",
        "Contextual graphs with labeled axes"
      ],
      "misconceptions": [
        "Plotting the intercept on the wrong axis.",
        "Using slope steps without respecting graph scale or sign."
      ],
      "intro": "Graph linear functions and interpret key features.",
      "review": "Connect tables, graphs, equations, and contexts that represent the same relationship.",
      "mastery": "Interpret and create graphs on the coordinate plane while connecting points, axes, intercepts, and graphical information to mathematical situations.",
      "framework_section_packet_paths": [
        "reference_library/question_structures/section_enrichment.json#2.2",
        "reference_library/source_excerpts/section_source_excerpts.json#2.2",
        "sources/indexes/compact_stage_reference_map.json#2.2"
      ]
    },
    "2.3": {
      "section": "2.3",
      "title": "Writing Linear Equations",
      "learning_target": "Students will write linear equations from graphs, tables, and situations.",
      "i_can_statements": [
        "I can formulate linear equations from graphs, tables, and situations.",
        "I can apply slope-intercept structure to connect rate and starting value.",
        "I can design equivalent equations that represent the same linear relationship."
      ],
      "vocabulary": [
        "slope-intercept form",
        "slope",
        "initial value",
        "$m$",
        "$b$"
      ],
      "key_representations": [
        "Slope-intercept equations",
        "Tables of input-output values",
        "Graphs with marked intercepts",
        "Verbal descriptions of rates and starting values",
        "Equivalent equation forms"
      ],
      "misconceptions": [
        "Using an arbitrary table value as the intercept.",
        "Confusing the roles of $m$ and $b$ in $y=mx+b$."
      ],
      "intro": "Write linear equations from graphs, tables, and situations.",
      "review": "Interpret and rewrite algebraic expressions by identifying structure, meaning, and equivalent forms.",
      "mastery": "Represent linear relationships using tables, graphs, equations, and contextual descriptions.",
      "framework_section_packet_paths": [
        "reference_library/question_structures/section_enrichment.json#2.3",
        "reference_library/source_excerpts/section_source_excerpts.json#2.3",
        "sources/indexes/compact_stage_reference_map.json#2.3"
      ]
    },
    "2.4": {
      "section": "2.4",
      "title": "Comparing Linear Representations",
      "learning_target": "Students will analyze and compare linear relationships using multiple representations.",
      "i_can_statements": [
        "I can construct comparison models for linear relationships shown in different forms.",
        "I can use slope and intercept information to interpret similarities and differences.",
        "I can critique conclusions about linear relationships using evidence from representations."
      ],
      "vocabulary": [
        "slope",
        "intercept",
        "rate",
        "starting value",
        "equivalent relationship"
      ],
      "key_representations": [
        "Pairs of graphs",
        "Tables with different scales",
        "Equations in slope-intercept form",
        "Contextual descriptions",
        "Feature comparison organizers"
      ],
      "misconceptions": [
        "Comparing lines only by current output values instead of rate and starting value.",
        "Assuming the steeper-looking graph has greater slope without checking axis scales."
      ],
      "intro": "Analyze and compare linear relationships using multiple representations.",
      "review": "Recognize common function families from graphs, tables, equations, and contexts.",
      "mastery": "Compare relationships using equations, graphs, tables, visual patterns, and contexts, then justify conclusions.",
      "framework_section_packet_paths": [
        "reference_library/question_structures/section_enrichment.json#2.4",
        "reference_library/source_excerpts/section_source_excerpts.json#2.4",
        "sources/indexes/compact_stage_reference_map.json#2.4"
      ]
    },
    "2.5": {
      "section": "2.5",
      "title": "Linear Modeling with Data",
      "learning_target": "Students will use linear models to represent and interpret real-world data.",
      "i_can_statements": [
        "I can design linear models that represent patterns in real-world data.",
        "I can predict values using a linear model and interpret the result.",
        "I can assess whether a linear model fits a data situation well enough for the question being asked."
      ],
      "vocabulary": [
        "linear model",
        "data",
        "trend",
        "prediction",
        "model fit"
      ],
      "key_representations": [
        "Scatter plots",
        "Lines of fit",
        "Tables of real-world data",
        "Linear model equations",
        "Residual-style reasonableness observations"
      ],
      "misconceptions": [
        "Treating every data set as perfectly linear.",
        "Using a prediction far outside the meaningful data range without considering model limits."
      ],
      "intro": "Use linear models to represent and interpret real-world data.",
      "review": "Write, solve, and interpret equations that model situations.",
      "mastery": "Identify patterns and represent relationships using input-output rules, tables, words, and symbols.",
      "framework_section_packet_paths": [
        "reference_library/question_structures/section_enrichment.json#2.5",
        "reference_library/source_excerpts/section_source_excerpts.json#2.5",
