    "6.5": {
      "section": "6.5",
      "title": "Quadratic Modeling and Optimization",
      "learning_target": "Students will use quadratic functions to model real-world situations and interpret maximums, minimums, and intercepts.",
      "i_cans": [
        "I can construct quadratic models from real-world constraints, data, or key features.",
