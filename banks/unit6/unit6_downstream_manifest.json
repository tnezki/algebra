  "unit_title": "Solving and Modeling with Quadratics",
  "section_summaries": {
    "6.1": {
      "section": "6.1",
      "title": "Solving Quadratics by Factoring",
      "learning_target": "Students will solve quadratic equations using factored form and interpret solutions.",
      "i_cans": [
        "I can construct factored quadratic equations from given zeros, intercepts, or contextual constraints.",
        "I can apply the zero product property to solve quadratic equations in factored form.",
        "I can determine whether solutions make sense in relation to a graph or context."
      ],
      "vocabulary": [
        "quadratic equation",
        "factored form",
        "zero product property",
        "zero",
        "solution"
      ],
      "key_representations": [
        "Factored quadratic equations",
        "Zeros and $x$-intercepts",
        "Tables of values",
        "Graphs of parabolas",
        "Contextual solution statements"
      ],
      "misconceptions": [
        "Applying the zero product property before the equation is set equal to zero.",
        "Keeping factor values instead of solving each factor equation for the variable."
      ],
      "intro": "Solve quadratic equations using factored form and interpret solutions.",
      "review": "Connect factors, zeros, intercepts, and graphs of quadratic functions.",
      "mastery": "Connect polynomial expressions to quadratic graphs and key features.",
      "framework_section_packet": "reference_library/question_structures/section_enrichment.json"
    },
    "6.2": {
      "section": "6.2",
      "title": "Completing the Square",
      "learning_target": "Students will solve quadratic equations by completing the square and connect the process to vertex form.",
      "i_cans": [
        "I can build perfect-square trinomials by adding the needed constant term.",
        "I can use completing the square to solve quadratic equations and write equivalent vertex-form expressions.",
        "I can predict how completing the square reveals the vertex and symmetry of a quadratic function."
      ],
      "vocabulary": [
        "complete the square",
        "perfect-square trinomial",
        "vertex form",
        "vertex",
        "equivalent form"
      ],
      "key_representations": [
        "Standard form equations",
        "Perfect-square trinomials",
        "Vertex form expressions",
        "Algebra tiles or area models",
        "Parabola vertices and axes of symmetry"
      ],
      "misconceptions": [
        "Adding a term to one side without preserving equality.",
        "Using the coefficient of the linear term instead of half that coefficient when forming a square."
      ],
      "intro": "Solve quadratic equations by completing the square and connect the process to vertex form.",
      "review": "Compare standard, vertex, and factored forms of quadratic functions and determine which form best reveals key features.",
      "mastery": "Graph and write translated functions using key points and key features.",
      "framework_section_packet": "reference_library/question_structures/section_enrichment.json"
    },
    "6.3": {
      "section": "6.3",
      "title": "Quadratic Formula",
      "learning_target": "Students will solve quadratic equations using the quadratic formula and interpret solutions.",
      "i_cans": [
        "I can design a coefficient map that organizes $a$, $b$, and $c$ before using the quadratic formula.",
        "I can apply the quadratic formula to solve equations with rational, irrational, or no real solutions.",
        "I can assess how the discriminant predicts the number and type of real solutions."
      ],
      "vocabulary": [
        "quadratic formula",
        "discriminant",
        "$a$",
        "$b$",
        "$c$"
      ],
      "key_representations": [
        "Standard form equations",
        "Quadratic formula",
        "Discriminant values",
        "Exact and approximate solutions",
        "Graphs with two, one, or no $x$-intercepts"
      ],
      "misconceptions": [
        "Substituting signs incorrectly for $a$, $b$, or $c$.",
        "Ignoring the discriminant when interpreting the number or type of real solutions."
      ],
      "intro": "Solve quadratic equations using the quadratic formula and interpret solutions.",
      "review": "Identify common factors and use structure to rewrite polynomial expressions.",
      "mastery": "Add, subtract, and multiply polynomial expressions.",
      "framework_section_packet": "reference_library/question_structures/section_enrichment.json"
    },
    "6.4": {
      "section": "6.4",
      "title": "Choosing and Defending Solution Methods",
      "learning_target": "Students will compare factoring, completing the square, and the quadratic formula and select efficient solution methods.",
      "i_cans": [
        "I can formulate a solution-method plan based on the structure of a quadratic equation.",
        "I can use factoring, completing the square, or the quadratic formula when the equation structure supports the method.",
        "I can critique a selected solution method for efficiency, accuracy, and fit to the equation."
      ],
      "vocabulary": [
        "factoring",
        "completing the square",
        "quadratic formula",
        "efficiency",
        "equation structure"
      ],
      "key_representations": [
        "Standard form equations",
        "Factored form equations",
        "Vertex form equations",
        "Method-selection flowcharts",
        "Written solution-method comparisons"
      ],
      "misconceptions": [
        "Choosing a familiar method without considering equation structure or efficiency.",
        "Claiming a method is best without comparing accuracy, complexity, or available structure."
      ],
      "intro": "Compare factoring, completing the square, and the quadratic formula and select efficient solution methods.",
      "review": "Recognize and factor special polynomial patterns.",
      "mastery": "Identify common function families from graphs, equations, tables, and contexts.",
      "framework_section_packet": "reference_library/question_structures/section_enrichment.json"
